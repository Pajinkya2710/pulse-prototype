{
  "name": "pulse",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "seed": "npm run seed -w server",
    "rebuild": "npm run rebuild -w server",
    "verify": "npm run verify -w server",
    "tamper": "npm run tamper -w server --",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "e2e": "tsx e2e/e2e.mts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright-core": "^1.52.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
